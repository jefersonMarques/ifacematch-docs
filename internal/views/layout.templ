package views

import "github.com/a-h/templ"

type Link struct {
	Label string
	URL   string
}

type Group struct {
	Title string
	Links []Link
}

type Page struct {
	Path        string
	Title       string
	Description string
	Body        string
	Contents    string
	SearchQuery string
}

type SearchResult struct {
	Path        string
	Title       string
	Description string
}

func canonicalURL(path string) string {
	return "https://docs.ifacematch.com" + path
}

templ Layout(page Page, groups []Group, body templ.Component) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			if page.Path == "/search" {
				<meta name="robots" content="noindex,follow"/>
			} else {
				<meta name="robots" content="index,follow,max-snippet:-1"/>
				<link rel="canonical" href={ canonicalURL(page.Path) }/>
			}
			<meta name="description" content={ page.Description }/>
			<title>{ page.Title } — iFaceMatch Docs</title>
			<meta property="og:type" content="article"/>
			<meta property="og:title" content={ page.Title }/>
			<meta property="og:description" content={ page.Description }/>
			if page.Path != "/search" {
				<meta property="og:url" content={ canonicalURL(page.Path) }/>
			}
			<link rel="alternate" type="text/markdown" href="/docs.md" title="Documentação para IAs"/>
			<link rel="stylesheet" href="/assets/docs.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#content">Pular para o conteúdo</a>
			<header class="site-header">
				<a class="brand" href="/docs.html" aria-label="iFaceMatch documentação">
					<span class="brand-mark" aria-hidden="true"></span>
					iFaceMatch
					<span class="brand-divider"></span>
					<span class="brand-docs">Documentação</span>
				</a>
				<div class="header-actions">
					<div class="search-wrap">
						<form role="search" action="/search" method="get">
							<input
								class="search-field"
								id="documentation-search"
								type="search"
								name="q"
								value={ page.SearchQuery }
								placeholder="Buscar documentação..."
								aria-label="Buscar na documentação"
								aria-controls="search-results"
								autocomplete="off"
								hx-get="/search"
								hx-trigger="input changed delay:250ms"
								hx-target="#search-results"
								hx-swap="innerHTML"
								hx-sync="this:replace"
							/>
							<div id="search-results" class="search-results" aria-live="polite" role="region" aria-label="Resultados da busca"></div>
						</form>
					</div>
					<a class="header-link" href="/releases.html">Releases</a>
					<a class="header-link" href="https://portal.ifacematch.com/">Portal</a>
					<button type="button" class="menu-toggle" data-menu-toggle aria-label="Abrir menu de documentação" aria-controls="docs-sidebar" aria-expanded="false">☰ Menu</button>
				</div>
			</header>
			<div class="mobile-backdrop" data-mobile-backdrop></div>
			<div class="docs-layout">
				<nav class="sidebar" data-sidebar id="docs-sidebar" aria-label="Índice da documentação">
					for _, group := range groups {
						<div class="sidebar-section">
							<p class="sidebar-title">{ group.Title }</p>
							for _, link := range group.Links {
								if page.Path == link.URL {
									<a class="sidebar-link" href={ link.URL } aria-current="page">{ link.Label }</a>
								} else {
									<a class="sidebar-link" href={ link.URL }>{ link.Label }</a>
								}
							}
						</div>
					}
					<div class="sidebar-note">Documentação pública do iFaceMatch Customer Hosted. Credenciais e imagens biométricas permanecem no ambiente da instalação.</div>
				</nav>
				<div class="document-area">
					<main class="document" id="content">
						@body
					</main>
					if page.Contents != "" {
						<aside class="toc" aria-label="Nesta página">
							@templ.Raw(page.Contents)
						</aside>
					}
				</div>
			</div>
		</body>
	</html>
}

templ DocumentPage(page Page, groups []Group) {
	@Layout(page, groups, templ.Raw(page.Body))
}

templ SearchListing(query string, results []SearchResult) {
	<nav class="breadcrumb" aria-label="Caminho"><a href="/docs.html">Docs</a><span>/</span>Busca</nav>
	<h1>Buscar documentação</h1>
	if query == "" {
		<p class="lead">Digite uma palavra ou expressão para encontrar tópicos.</p>
	} else {
		<p class="lead">Resultados para “{ query }”</p>
		if len(results) == 0 {
			<p>Nenhum resultado encontrado.</p>
		} else {
			<div class="search-list">
				for _, item := range results {
					<a class="link-card" href={ item.Path }>
						<strong>{ item.Title }</strong>
						<span>{ item.Description }</span>
					</a>
				}
			</div>
		}
	}
}

templ SearchPage(page Page, groups []Group, results []SearchResult) {
	@Layout(page, groups, SearchListing(page.SearchQuery, results))
}

templ SearchResults(query string, results []SearchResult) {
	if query != "" {
		if len(results) == 0 {
			<div class="search-result">Nenhum resultado encontrado.</div>
		} else {
			for _, item := range results {
				<a class="search-result" href={ item.Path }>
					<strong>{ item.Title }</strong>
					<small>{ item.Description }</small>
				</a>
			}
		}
	}
}
